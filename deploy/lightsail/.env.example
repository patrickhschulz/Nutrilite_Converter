DOMAIN=converter.example.com
ACME_EMAIL=owner@example.com
DATA_DIR=/opt/nutrilite-converter/shared/data
APP_VERSION=latest
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini
APP_ACCESS_TOKEN=REPLACE_WITH_GENERATED_64_CHARACTER_TOKEN
ANALYSIS_RATE_LIMIT_PER_HOUR=20
MAX_REQUEST_BYTES=8500000
MAX_IMAGE_BYTES=6000000
CADDY_MAX_REQUEST_BODY_SIZE=8500000
